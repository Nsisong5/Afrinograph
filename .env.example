# Application Environment (local, test, ci, prod)
APP_ENV=local

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# PostgreSQL Database URL for development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/afrinograph_dev

# PostgreSQL Database URL for testing
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/afrinograph_test
